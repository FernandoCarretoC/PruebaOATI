# Local (fuera de Docker Compose)
DATABASE_URL=postgresql://oati:oati_secret@localhost:5432/series_db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# En Render usar DEBUG=false
DEBUG=true

# --- Render (Web Service backend) ---
# DATABASE_URL=<Internal Database URL del PostgreSQL de Render>
# CORS_ORIGINS=https://pruebaoati-frontend.onrender.com,http://localhost:4200
# DEBUG=false
# PORT lo asigna Render automáticamente; no hace falta definirlo
